  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Próximo día hábil (lunes a sábado) para que las pruebas no caduquen",
          "if (!pm.collectionVariables.get('fecha')) { const d = new Date(); do { d.setDate(d.getDate() + 1); } while (d.getDay() === 0); pm.collectionVariables.set('fecha', d.toISOString().slice(0, 10)); }"
        ]
      }
    }
  ],
